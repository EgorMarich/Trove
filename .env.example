# Backend
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

# Booking.com Demand API v3.2
# Obtain these credentials only through the Booking.com Managed Affiliate Partner / Partner Centre flow.
BOOKING_API_BASE_URL=https://demandapi-sandbox.booking.com/3.2
BOOKING_API_KEY=
BOOKING_AFFILIATE_ID=
BOOKING_BOOKER_COUNTRY=ru
BOOKING_CURRENCY=EUR
BOOKING_DEFAULT_CITY_ID=
# Example: {"Amsterdam":-2140479,"Paris":-1456928}
BOOKING_CITY_MAP_JSON={}

# Persistence
# Leave empty for local in-memory development. Set both for v1.1 infrastructure mode.
DATABASE_URL=postgresql://trove:trove_dev_password@localhost:5432/trove
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
REDIS_URL=redis://localhost:6379
