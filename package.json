{
  "name": "trove",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "build:frontend": "pnpm --dir frontend build",
    "dev:backend": "pnpm --dir backend dev",
    "build:backend": "pnpm --dir backend build",
    "beta:up": "bash deploy/beta-up.sh",
    "beta:down": "bash deploy/beta-down.sh",
    "beta:e2e": "bash deploy/beta-e2e.sh",
    "beta:qa": "bash deploy/beta-quality-gate.sh",
    "real:preflight": "bash deploy/real-beta-preflight.sh",
    "real:e2e": "pnpm --dir backend test:real-e2e",
    "real:docs": "cat docs/REAL_TEST_SETUP.md"
  },
  "version": "2.6.0"
}
